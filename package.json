{
  "name": "ratatoskr",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/copy-fonts.ts && vite",
    "build": "node scripts/copy-fonts.ts && vite build",
    "types": "wrangler types",
    "typecheck": "tsc -p tsconfig.json && tsc -p tests/tsconfig.json && tsc -p scripts/tsconfig.json",
    "test": "vitest run",
    "verify": "bun run types && bun run typecheck && bun run test && bun run build",
    "setup": "node scripts/setup.ts",
    "deploy": "node scripts/deploy.ts",
    "verify:deployment": "node scripts/verify-deployment.ts",
    "verify:live-links": "node scripts/verify-live-links.ts"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.63.1",
    "@cloudflare/vitest-plugin": "^1.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "undici": "^8.11.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4",
    "wrangler": "^4.149.0"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "hono": "^4.13.13",
    "jose": "^6.2.12",
    "lucide-react": "^1.55.0",
    "radix-ui": "^1.8.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.6"
  },
  "type": "module"
}
