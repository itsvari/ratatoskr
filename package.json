{
  "name": "ratatoskr",
  "version": "1.0.0",
  "private": true,
  "packageManager": "bun@1.4.4",
  "engines": {
    "bun": ">=1.4.4",
    "node": "^22.23.4 || ^24.22.1 || >=26.12.1"
  },
  "overrides": {
    "undici@^7": "^7.30.1",
    "undici-types": "^8.12.3",
    "why-is-node-running": "^3.2.3",
    "workerd": "^1.20261024.1",
    "youch": "^4.1.1",
    "zod": "^4.6.7"
  },
  "scripts": {
    "preinstall": "node scripts/check-runtime.ts",
    "check:runtime": "node scripts/check-runtime.ts",
    "dev": "node scripts/check-runtime.ts && node scripts/copy-fonts.ts && vite",
    "build": "node scripts/check-runtime.ts && node scripts/copy-fonts.ts && vite build",
    "types": "wrangler types",
    "typecheck": "tsc -p tsconfig.json && tsc -p tests/tsconfig.json && tsc -p scripts/tsconfig.json",
    "test": "vitest run",
    "verify": "bun run check:runtime && bun run types && bun run typecheck && bun run test && bun run build",
    "generate:preview-header": "bun scripts/generate-preview-header.ts",
    "profile:preview:deployed": "node scripts/profile-preview-deployed.ts",
    "profile:preview": "node scripts/check-runtime.ts && node scripts/profile-preview.ts",
    "setup": "node scripts/setup.ts",
    "deploy": "node scripts/deploy.ts",
    "verify:deployment": "node scripts/verify-deployment.ts",
    "verify:live-links": "node scripts/verify-live-links.ts"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.65.0",
    "@cloudflare/vitest-plugin": "^1.4.7",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "esbuild": "^0.28.2",
    "miniflare": "5.20261019.2-beta",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "undici": "^8.12.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "wrangler": "^4.152.0"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@resvg/resvg-wasm": "^2.6.2",
    "bidi-js": "^1.1.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "hono": "^4.13.13",
    "jose": "^6.2.13",
    "lucide-react": "^1.61.0",
    "pako": "^3.0.3",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "type": "module"
}
